# Copy this file to .env and fill in your values. NEVER commit .env.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# SQLite by default. For PostgreSQL use e.g. postgres://user:pass@localhost:5432/psychbuddy
DATABASE_URL=sqlite:///db.sqlite3

# --- LLM (any OpenAI-compatible API) ---
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Leave blank for OpenAI. Examples:
#   Groq:       https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Gemini:     https://generativelanguage.googleapis.com/v1beta/openai/
#   Ollama:     http://localhost:11434/v1
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30

# --- RAG ---
# sentence-transformers (default) or tfidf (no model download, lighter fallback)
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=4
# Max distance (cosine) for a chunk to count as relevant (lower = stricter)
RAG_MAX_DISTANCE=0.75

# --- Crisis resources shown on high-risk messages (JSON list) ---
# Replace with resources for your country.
CRISIS_RESOURCES=[{"name":"Local emergency services","contact":"Call your local emergency number"},{"name":"A trusted person","contact":"Reach out to a friend, family member or someone nearby right now"},{"name":"Crisis line","contact":"Search for a crisis helpline in your country (e.g. findahelpline.com)"}]
